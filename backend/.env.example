# Telegram API credentials (https://my.telegram.org/apps)
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
# Bot token from @BotFather (the bot must be an admin in the destination channel)
TELEGRAM_BOT_TOKEN=
# Optional overrides
TELEGRAM_SESSION_NAME=reposter_session
# Channels ---
# Comma-separated list of source channels to listen on (up to 3).
# Example: @chan_one,https://t.me/chan_two,-1001234567890
TELEGRAM_SOURCE_CHANNELS=
# Legacy single-source key, kept in sync with the first entry above.
TELEGRAM_SOURCE_CHANNEL=
TELEGRAM_DESTINATION_CHANNEL=
# Repost mode is fixed to "copy" (a bot cannot forward from a channel it is
# not a member of). Do not change this value.
REPOST_MODE=copy
# Posting delay ---
# Basic build default: a fixed 10-second pause before every repost.
DELAY_ENABLED=true
DELAY_MIN_SECONDS=10
DELAY_MAX_SECONDS=10
