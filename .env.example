# Telegram Reposter - configuration template
# Copy this file to backend/.env and fill in the values, or just use the
# dashboard: every Save writes backend/.env, which is the single source of truth.

# --- Telegram API credentials (https://my.telegram.org -> API development tools)
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=

# --- Bot token from @BotFather (the bot must be an admin in the destination)
TELEGRAM_BOT_TOKEN=

# --- Channels (@username, https://t.me/name, or -100... numeric id)
# Comma-separated list of source channels to listen on (up to 3).
TELEGRAM_SOURCE_CHANNELS=
# Legacy single-source key, kept in sync with the first entry above.
TELEGRAM_SOURCE_CHANNEL=
TELEGRAM_DESTINATION_CHANNEL=

# --- Behaviour
TELEGRAM_SESSION_NAME=reposter_session
# Repost mode is fixed to "copy" (forward is not supported). Do not change.
REPOST_MODE=copy
DELAY_ENABLED=false
DELAY_MIN_SECONDS=0
DELAY_MAX_SECONDS=0
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=2
